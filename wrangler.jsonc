// Cloudflare Workers configuration for Stilet Dekor.
// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
//
// This file is the *input* config. `astro build` (via @cloudflare/vite-plugin) writes the
// deployable config to dist/server/wrangler.json and a redirect in .wrangler/deploy/config.json,
// so `wrangler deploy` / `wrangler preview` from the repo root pick up the built worker.
//
// Workers Builds (Cloudflare dashboard, Git integration): production branch main -> `npx wrangler deploy`
// (this top-level dev site); every other branch -> `npx wrangler preview` (a Preview, see "previews").
// Two design directions are kept for now, one dev site each (SITE_THEME): the top level is dev site A
// ("neon-muhely"); env.galeria is dev site B, a second Worker built from main with CLOUDFLARE_ENV=galeria.
//
// Filling in real resource IDs (once per environment):
//   npx wrangler d1 create stiletdekor-dev          -> copy "database_id" into d1_databases below
//   npx wrangler d1 create stiletdekor-prod         -> copy into env.production.d1_databases
//   npx wrangler r2 bucket create stiletdekor-uploads-dev   (once R2 is enabled on the account)
//   npx wrangler r2 bucket create stiletdekor-uploads-prod
// Then apply migrations remotely:
//   npx wrangler d1 migrations apply DB --remote
//   npx wrangler d1 migrations apply DB --remote --env production
// After any binding/var change run `npm run cf-typegen` to refresh worker-configuration.d.ts.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stiletdekor",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Worker entry: Astro answers requests, the cron retries the workshop's notifications (src/worker.ts).
  // The build replaces it with the bundled output.
  "main": "./src/worker.ts",
  // Static assets (dist/client) are wired up by the adapter; only the binding name is fixed here.
  "assets": {
    "binding": "ASSETS"
  },
  // Settings in this file win on every deploy: a dashboard-only change (e.g. turning Issues on there) is undone
  // by the next `wrangler deploy`, so observability is set here.
  "observability": {
    "enabled": true,
    // Issues: groups uncaught exceptions, failed invocations, 5xx responses and logged errors (dashboard: Issues).
    "issues": { "enabled": true }
  },
  // Version preview URLs (one per uploaded version).
  "preview_urls": true,

  // ---- dev site (default, top level): deployed by Workers Builds from the main branch ----
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stiletdekor-dev",
      // Created 2026-10-05 in EEUR (Eastern Europe).
      "database_id": "fb3e2883-e461-42ac-94d9-81d3a4f1f2d2",
      "migrations_dir": "migrations"
    }
  ],
  // R2 (customer uploads) is not bound yet: R2 is not enabled on the Cloudflare account, and a binding
  // to a bucket that does not exist makes the deploy fail. Nothing uses env.UPLOADS yet. When file
  // upload is built: enable R2 in the dashboard, create the bucket, then restore this block here, in
  // "previews" and in env.production, and make UPLOADS required again in src/env.d.ts.
  // "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "stiletdekor-uploads-dev" }],
  // The site's forms: at most 5 posts per visitor (IP) and form per minute. Not inherited: repeated in every environment.
  "ratelimits": [
    { "name": "FORM_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    // File uploads: at most 20 files per visitor (IP) and minute (src/server/upload/receive.ts).
    { "name": "UPLOAD_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  // Retries the workshop's notification e-mails every 15 minutes (src/server/callback/notify.ts).
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "PUBLIC_SITE_ENV": "dev",
    "SITE_THEME": "neon-muhely",
    "ORDER_NOTIFY_EMAIL": "stiletdekor@gmail.com",
    // Comma-separated extra origins accepted by POST endpoints besides the site's own origin.
    "ALLOWED_ORIGINS": "",
    "NOTIFY_FROM_EMAIL": "",
    "CF_BEACON_TOKEN": ""
  },

  // ---- Workers Previews (`npx wrangler preview`, the Workers Builds preview command) ----
  // Every branch other than the production branch (main) gets its own Preview URL.
  // Previews do not inherit top-level vars or bindings, so they are declared again here.
  // All Previews share the dev D1 database as their staging database (test data only).
  // Docs: https://developers.cloudflare.com/workers/previews/configuration/
  "previews": {
    "observability": { "enabled": true },
    "ratelimits": [
      { "name": "FORM_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
      // File uploads: at most 20 files per visitor (IP) and minute (src/server/upload/receive.ts).
      { "name": "UPLOAD_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
    ],
    "vars": {
      "PUBLIC_SITE_ENV": "dev",
      "SITE_THEME": "neon-muhely",
      "ORDER_NOTIFY_EMAIL": "stiletdekor@gmail.com",
      "ALLOWED_ORIGINS": "",
      "NOTIFY_FROM_EMAIL": "",
      "CF_BEACON_TOKEN": ""
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "stiletdekor-dev",
        "database_id": "fb3e2883-e461-42ac-94d9-81d3a4f1f2d2",
        "migrations_dir": "migrations"
      }
    ]
  },

  "env": {
    // ---- dev site B: the "Galéria / editorial" direction, its own Worker (stiletdekor-galeria) ----
    // Workers Builds for that Worker: build command `CLOUDFLARE_ENV=galeria npm run build`, deploy command
    // `npx wrangler deploy`, production branch main, preview builds off (Previews come from dev site A).
    // Same dev database as dev site A. Vars and bindings are not inherited, so they are repeated here.
    "galeria": {
      "name": "stiletdekor-galeria",
      "ratelimits": [
        { "name": "FORM_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
        // File uploads: at most 20 files per visitor (IP) and minute (src/server/upload/receive.ts).
        { "name": "UPLOAD_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
      ],
      // Both dev sites share one database: dev site A's cron is enough.
      "triggers": { "crons": [] },
      "observability": {
        "enabled": true,
        "issues": { "enabled": true }
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "stiletdekor-dev",
          "database_id": "fb3e2883-e461-42ac-94d9-81d3a4f1f2d2",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "PUBLIC_SITE_ENV": "dev",
        "SITE_THEME": "galeria-editorial",
        "ORDER_NOTIFY_EMAIL": "stiletdekor@gmail.com",
        "ALLOWED_ORIGINS": "",
        "NOTIFY_FROM_EMAIL": "",
        "CF_BEACON_TOKEN": ""
      }
    },

    // ---- production: the future live site (www.stiletdekor.hu), not deployed yet ----
    // Build with CLOUDFLARE_ENV=production, then `npx wrangler deploy` (the environment is fixed at build time).
    // Bindings and vars are not inherited from the top level, so they are repeated here.
    "production": {
      "name": "stiletdekor-production",
      "ratelimits": [
        { "name": "FORM_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
        // File uploads: at most 20 files per visitor (IP) and minute (src/server/upload/receive.ts).
        { "name": "UPLOAD_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
      ],
      "triggers": { "crons": ["*/15 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "stiletdekor-prod",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      // "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "stiletdekor-uploads-prod" }],  (see top-level note)
      "vars": {
        "PUBLIC_SITE_ENV": "production",
        // The chosen design direction; not decided yet (both directions are kept for now).
        "SITE_THEME": "neon-muhely",
        "ORDER_NOTIFY_EMAIL": "stiletdekor@gmail.com",
        "ALLOWED_ORIGINS": "",
        "NOTIFY_FROM_EMAIL": "",
        "CF_BEACON_TOKEN": ""
      }
      // When the domain is connected:
      // "routes": [{ "pattern": "www.stiletdekor.hu", "custom_domain": true }]
    }
  }
}
