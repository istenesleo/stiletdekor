# dependencies
node_modules/

# build output
dist/
# the UI library as a package (npm run build:ui), the input of /design-sync
dist-ui/

# /design-sync: staged converter and local state. Its output, ds-bundle/, is committed with the rest of
# .design-sync/ as the snapshot of the last sync.
.ds-sync/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# generated by astro sync / dev
.astro/

# wrangler / miniflare local state (local D1, R2) and deploy redirect
.wrangler/

# local secrets
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*

# logs and OS/editor files
npm-debug.log*
*.log
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# the local switcher file of the page designs (npm run latvanytervek)
Arculati látványtervek.html

# Claude Design handoff downloads (the extracted project files are committed in design/claude-design/)
design/claude-design/*.zip
