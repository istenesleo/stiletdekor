{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "dist-ui", "ds-bundle", "node_modules", ".wrangler"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    // `baseUrl` is deprecated in TypeScript 6; `paths` resolve relative to this file.
    "paths": {
      "@/*": ["./src/*"]
    },
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true
  }
}
