---
import { env } from 'cloudflare:workers';
import Base from '@/layouts/Base.astro';
import { designPreviewHtml } from '@/site/design-preview';
import { siteThemeOf } from '@/site/themes';

// Until the home page is built, the dev sites (one per design direction) show their direction's mockup.
// Production keeps the placeholder below.
if (env.PUBLIC_SITE_ENV !== 'production') {
  return new Response(designPreviewHtml(siteThemeOf(env.SITE_THEME)), {
    headers: { 'Content-Type': 'text/html; charset=utf-8' },
  });
}
---

<Base
  title="Stilet Dekor – fóliázás, cégér, nyomtatás saját műhelyből"
  description="Fóliázás, cégér- és reklámtábla-gyártás, nyomtatás és rendezvénydíszlet saját műhellyel, helyszíni felméréssel és telepítéssel."
>
  <main class="placeholder">
    <p class="wordmark">STILET DEKOR</p>
    <h1>Az új weboldal hamarosan elkészül.</h1>
    <p>Addig is hívjon minket vagy írjon nekünk.</p>
    <p>
      <a href="tel:+36705385030">+36 70 538 5030</a>
      ·
      <a href="mailto:stiletdekor@gmail.com">stiletdekor@gmail.com</a>
    </p>
  </main>
</Base>

<style>
  .placeholder {
    max-width: var(--layout-container);
    margin: 0 auto;
    padding: var(--space-8) var(--layout-gutter);
  }

  .wordmark {
    color: var(--color-brand);
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: var(--leading-snug);
  }
</style>
