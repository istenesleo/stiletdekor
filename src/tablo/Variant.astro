---
// Renders a finished variant of the /tablo board by its id. When a variant's status becomes 'kesz', import its
// component here and add its line below; variants.test.ts checks that every finished variant is listed.
import G1Jelenetek from './grafika/G1Jelenetek.astro';
import G2Piktogramok from './grafika/G2Piktogramok.astro';
import G3Motivumok from './grafika/G3Motivumok.astro';
import G4Szomarka from './grafika/G4Szomarka.astro';

interface Props {
  id: string;
  /** Heading level of a full direction's main heading: 4 on the board (default), 2 on its own page. */
  fejlec?: 2 | 4;
}

const { id, fejlec = 4 } = Astro.props;
---

{id === 'G1' && <G1Jelenetek />}
{id === 'G2' && <G2Piktogramok />}
{id === 'G3' && <G3Motivumok />}
{id === 'G4' && <G4Szomarka />}
